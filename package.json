{
  "name": "opencodegoboard",
  "version": "1.2.7",
  "description": "OpenCode Go 本地额度与用量决策面板",
  "main": "dist-electron/main.js",
  "author": "OpenCodeBoard",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm build:electron && pnpm rebuild:native && concurrently -k \"pnpm dev:vite\" \"wait-on dist-electron/main.js http://localhost:5173 && electron .\"",
    "dev:vite": "vite",
    "build": "pnpm build:vite && pnpm build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture:sanitize": "node scripts/sanitize-fixture.mjs",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "build:vite": "vite build",
    "build:electron": "tsc --project electron/tsconfig.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "dist": "pnpm build && pnpm rebuild:native && npx --yes electron-builder@25",
    "dist:dir": "pnpm build && pnpm rebuild:native && npx --yes electron-builder@25 --dir",
    "postinstall": "pnpm build:electron",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.opencodeboard.app",
    "productName": "OpenCodeBoard",
    "directories": {
      "output": "release"
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/bin/**",
      "!node_modules/better-sqlite3/build/deps/**",
      "!node_modules/better-sqlite3/build/Release/obj/**",
      "!node_modules/better-sqlite3/build/Release/*.iobj",
      "!node_modules/better-sqlite3/build/Release/*.ipdb",
      "!node_modules/better-sqlite3/build/Release/*.lib",
      "!node_modules/better-sqlite3/build/Release/*.exp",
      "!node_modules/better-sqlite3/build/Release/test_extension*",
      "!node_modules/better-sqlite3/build/*.vcxproj*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "public/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenCodeBoard",
      "language": "2052",
      "unicode": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "opencode",
    "go"
  ],
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tauri-apps/cli": "^2.11.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "daisyui": "^5.6.17",
    "electron": "^43.3.0",
    "i18next": "^26.3.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.10",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.12",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.10",
    "@lobehub/icons": "^5.15.0",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.12.30",
    "zod": "^4.4.3"
  }
}
