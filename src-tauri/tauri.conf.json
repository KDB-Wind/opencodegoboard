{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCodeGoBoard",
  "version": "0.1.0",
  "identifier": "com.kdbwind.opencodegoboard",
  "build": {
    "beforeBuildCommand": "pnpm build:vite",
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCodeGoBoard — Tauri Prototype",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
