{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenCodeGoBoard",
  "version": "1.2.7",
  "identifier": "com.kdbwind.opencodegoboard",
  "build": {
    "beforeBuildCommand": "pnpm build:vite",
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenCodeGoBoard",
        "decorations": false,
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../public/icon.ico"],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
